{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FlightLambdas",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:ListTags",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency"
      ],
      "Resource": "arn:aws:lambda:ap-southeast-2:379959319681:function:flight-*"
    },
    {
      "Sid": "FlightEventSourceMappings",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateEventSourceMapping",
        "lambda:UpdateEventSourceMapping",
        "lambda:GetEventSourceMapping",
        "lambda:DeleteEventSourceMapping"
      ],
      "Resource": "arn:aws:lambda:ap-southeast-2:379959319681:event-source-mapping:*",
      "Condition": {
        "StringLike": {
          "lambda:FunctionArn": "arn:aws:lambda:ap-southeast-2:379959319681:function:flight-*"
        }
      }
    },
    {
      "Sid": "FlightHttpApi",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PATCH",
        "apigateway:PUT",
        "apigateway:DELETE"
      ],
      "Resource": [
        "arn:aws:apigateway:ap-southeast-2::/apis",
        "arn:aws:apigateway:ap-southeast-2::/apis/*"
      ]
    },
    {
      "Sid": "FlightLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteLogGroup",
        "logs:DescribeLogGroups",
        "logs:TagResource"
      ],
      "Resource": "arn:aws:logs:ap-southeast-2:379959319681:log-group:/aws/lambda/flight-*"
    },
    {
      "Sid": "FlightSchedule",
      "Effect": "Allow",
      "Action": [
        "events:PutRule",
        "events:DescribeRule",
        "events:PutTargets",
        "events:RemoveTargets",
        "events:DeleteRule"
      ],
      "Resource": "arn:aws:events:ap-southeast-2:379959319681:rule/flight-*"
    },
    {
      "Sid": "ReadArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::flight-artifacts-379959319681/artifacts/*"
    },
    {
      "Sid": "PassExistingFlightLambdaRolesOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::379959319681:role/flight-lambda-role",
        "arn:aws:iam::379959319681:role/flight-subscriptions-api-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ProtectDataAndIdentity",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteTable",
        "dynamodb:UpdateTable",
        "dynamodb:DeleteItem",
        "dynamodb:BatchWriteItem",
        "sqs:DeleteQueue",
        "sqs:PurgeQueue",
        "ssm:GetParameter*",
        "ssm:PutParameter",
        "ssm:DeleteParameter*",
        "iam:Create*",
        "iam:Delete*",
        "iam:Put*",
        "iam:Attach*",
        "iam:Detach*",
        "iam:Update*",
        "s3:DeleteBucket"
      ],
      "Resource": "*"
    }
  ]
}
