{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubOidc",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::379959319681:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": [
            "repo:d6140085-dotcom/flight-fare-finder:environment:production"
          ]
        }
      }
    }
  ]
}
