{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SubscriptionsTableOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-2:379959319681:table/subscriptions"
    },
    {
      "Sid": "QuotaTableOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-2:379959319681:table/subscription_quota"
    },
    {
      "Sid": "OwnLogsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-southeast-2:379959319681:log-group:/aws/lambda/flight-subscriptions-api:*"
    }
  ]
}
