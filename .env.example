# Copy to .env.local for local development. Never commit real values.
# Production values are set in Vercel → Project → Settings → Environment Variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# AWS API Gateway base URL for the subscribe API (M1), e.g. https://<id>.execute-api.ap-southeast-2.amazonaws.com
VITE_FLIGHT_API_URL=

# M1.4 Phase 3B-C local HTTP mode (Vite dev server ONLY; every `vite build` blanks these and uses
# the mock). Leave unset for the default mock. Never set these in Vercel.
# VITE_M14_API_MODE=http
# VITE_M14_API_URL=http://127.0.0.1:<harness port>   # localhost only (aws/tools/local_api.py)
# VITE_M14_DEV_TOKEN=harness-token-user               # harness-token-user | -other | -third only
